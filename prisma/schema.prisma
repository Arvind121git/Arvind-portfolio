generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model About {
  id        String @id @default("1")
  name      String
  title     String
  tagline   String @db.Text
  bio       String @db.Text
  location  String
  email     String
  phone     String
  github    String
  linkedin  String
  twitter   String
  resumeUrl String
  stats     String @db.Text

  @@map("about")
}

model Skill {
  id       String @id
  name     String
  category String
  level    Int
  icon     String

  @@map("skills")
}

model Project {
  id          String  @id
  title       String
  description String  @db.Text
  category    String
  tags        String  @db.Text
  liveUrl     String
  githubUrl   String
  featured    Boolean @default(false)

  @@map("projects")
}

model Experience {
  id          String @id
  role        String
  company     String
  period      String
  description String @db.Text

  @@map("experience")
}

model Education {
  id          String @id
  degree      String
  institution String
  year        String
  grade       String

  @@map("education")
}

model Certificate {
  id           String @id
  title        String
  issuer       String
  date         String
  credentialId String
  link         String

  @@map("certificates")
}

model Message {
  id        String @id
  name      String
  email     String
  subject   String
  message   String @db.Text
  createdAt String

  @@map("messages")
}
